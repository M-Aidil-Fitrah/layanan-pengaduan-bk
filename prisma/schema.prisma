generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComplaintCategory {
  PERSONAL
  ACADEMIC
  SOCIAL
  EMOTIONAL_WELLBEING
  OTHER
}

enum ReporterAudience {
  STUDENT
  UNIVERSITY_STUDENT
  PARENT_OR_GUARDIAN
  OTHER
}

enum UrgencyLevel {
  CONSULTATION
  SOON
  UNSAFE_NOW
}

enum ComplaintStatus {
  RECEIVED
}

model Complaint {
  id           String           @id @default(cuid())
  trackingCode String           @unique @db.VarChar(64)
  category     ComplaintCategory
  audience     ReporterAudience
  urgency      UrgencyLevel
  title        String           @db.VarChar(100)
  details      String           @db.VarChar(2000)
  isAnonymous  Boolean
  name         String?          @db.VarChar(120)
  contact      String?          @db.VarChar(120)
  status       ComplaintStatus  @default(RECEIVED)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}
